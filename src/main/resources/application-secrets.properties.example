# Exemplo de configuração de chaves e segredos locais (NÃO comite suas chaves reais no git)
# Copie este arquivo para application-secrets.properties e preencha com seus valores locais.

# JWT
jwt.secret=
JWT_SECRET=

# AbacatePay
abacatepay.api.key=
ABACATEPAY_API_KEY=
abacatepay.webhook.secret=
ABACATEPAY_WEBHOOK_SECRET=

# OpenRouteService
openrouteservice.api.key=
OPENROUTESERVICE_API_KEY=

# MinIO (opcional, defaults: root / root@123)
# minio.access.key=root
# minio.secret.key=root@123
